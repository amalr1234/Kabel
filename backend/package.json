{
  "name": "solvia-backend",
  "private": true,
  "description": "npm shortcuts for the SOLVIA FastAPI backend (Windows venv paths).",
  "scripts": {
    "setup": "python -m venv .venv && .venv\\Scripts\\pip.exe install -r requirements.txt",
    "dev": ".venv\\Scripts\\uvicorn.exe app.main:app --reload --host 0.0.0.0 --port 8000",
    "start": ".venv\\Scripts\\uvicorn.exe app.main:app --host 0.0.0.0 --port 8000"
  }
}
